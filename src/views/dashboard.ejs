<%- include('partials/head') %>

<h1>Dashboard</h1>
<div class="meta">Fleet overview</div>

<div class="kpi-grid">
  <div class="kpi"><div class="label">Active Drivers</div><div class="value"><%= activeDrivers %></div></div>
  <a class="kpi kpi-link" href="/cars">
    <div class="label">Active Cars</div>
    <div class="value"><%= activeCars %></div>
  </a>
</div>

<div class="panel">
  <div class="panel-head"><h3>Fleet Income</h3></div>
  <form method="GET" action="/" class="form-grid" style="padding:14px 16px 0;">
    <div class="field"><label>From</label><input type="date" name="from" value="<%= from %>"></div>
    <div class="field"><label>To</label><input type="date" name="to" value="<%= to %>"></div>
    <div class="field" style="align-self:flex-end;">
      <button class="btn" type="submit">Filter</button>
      <a class="btn secondary" href="/">This Week</a>
      <a class="btn secondary" href="/export/fleet-income-pdf?from=<%= from %>&to=<%= to %>">Download PDF</a>
    </div>
  </form>

  <form method="POST" action="/fleet-totals">
    <input type="hidden" name="from" value="<%= from %>">
    <input type="hidden" name="to" value="<%= to %>">
    <table>
      <tr><th>Item</th><th>Amount</th></tr>
      <tr>
        <td>Fleet Charge Collected (<%= activeCars %> active car<%= activeCars === 1 ? '' : 's' %>)</td>
        <td>€<input type="number" step="0.01" name="fleetChargeTotal" value="<%= fleetChargeTotal.toFixed(2) %>" style="width:100px;"></td>
      </tr>
      <tr>
        <td>Manager Fees Paid Out (<%= activeCars %> active car<%= activeCars === 1 ? '' : 's' %>)</td>
        <td>-€<input type="number" step="0.01" name="managerFeeTotal" value="<%= managerFeeTotal.toFixed(2) %>" style="width:100px;"></td>
      </tr>
      <tr>
        <td colspan="2" style="padding:6px 0;">
          <button class="btn" type="submit">Save</button>
          <% if (isOverridden) { %>
            <span style="color:var(--muted); font-size:12.5px;">Manually edited for this period.</span>
          <% } %>
        </td>
      </tr>
      <tr>
        <td><b>Fleet Net (before expenses)</b></td>
        <td><b>€<%= fleetNetFromCars.toFixed(2) %></b></td>
      </tr>
      <tr>
        <td>Custom Payments in period (<a href="/custom-payments">manage</a>)</td>
        <td>+€<%= customPaymentsTotal.toFixed(2) %></td>
      </tr>
      <tr>
        <td>Expenses in period (<a href="/expenses">manage</a>)</td>
        <td>-€<%= expensesTotal.toFixed(2) %></td>
      </tr>
      <tr style="border-top:2px solid var(--border, #ccc);">
        <td><b>Final Fleet Net Income</b></td>
        <td><b style="font-size:1.2em;">€<%= finalNetIncome.toFixed(2) %></b></td>
      </tr>
    </table>
  </form>
  <% if (isOverridden) { %>
    <form method="POST" action="/fleet-totals/clear" style="padding:0 16px 14px;">
      <input type="hidden" name="from" value="<%= from %>">
      <input type="hidden" name="to" value="<%= to %>">
      <button class="btn secondary" type="submit">Reset to calculated (€<%= calculatedFleetChargeTotal.toFixed(2) %> / €<%= calculatedManagerFeeTotal.toFixed(2) %>)</button>
    </form>
  <% } %>
  <p style="padding:0 16px 14px; color:var(--muted); font-size:12.5px;">
    Fleet Charge Collected and Manager Fees Paid Out are editable above — type the real numbers for this period and click Save.
    They start out pre-filled from each active car's rate (set on the <a href="/cars">Cars</a> page), but once you save a manual value it's remembered for this exact date range until you reset it.
    The 6% IVA withheld from driver earnings is tracked separately and returned to drivers who issue a green receipt — see IVA Refunds.
  </p>
</div>

<div class="panel">
  <div class="panel-head"><h3>Alerts (next 30 days)</h3></div>
  <div style="padding:14px 16px;">
    <% if (alerts.length === 0) { %>
      <p style="color:var(--muted);">No upcoming expirations. You're clear for the next 30 days.</p>
    <% } %>
    <% alerts.forEach(a => { %>
      <div class="alert"><%= a %></div>
    <% }) %>
  </div>
</div>

<%- include('partials/foot') %>
